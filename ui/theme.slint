export global Theme {
    out property <brush> bg: #0a0a0b;
    out property <brush> panel: #131316;
    out property <brush> panel-alt: #0e0e11;
    out property <brush> raised: #1a1a1f;
    out property <brush> border: #202026;
    out property <brush> border-hover: #33333d;
    out property <brush> border-soft: #17171b;

    out property <color> text: #ececf0;
    out property <color> text-dim: #8b8b95;
    out property <color> text-faint: #55555e;

    out property <color> accent: #a3e60b;
    out property <color> accent-deep: #7ab000;
    out property <color> magenta: #d946ef;
    out property <color> purple: #7c5cff;
    out property <color> track: #26262c;

    out property <length> radius: 14px;
    out property <length> radius-sm: 9px;
    out property <length> gap: 14px;

    out property <string> font: "Segoe UI";
}
