import { Theme } from "theme.slint";
import { IconReset, IconResetHead } from "icons.slint";

/// The Talkdedsec mark. assets/logo.svg holds the traced vector twin of this
/// bitmap for README and icon use; the panel draws the raster so the halftone
/// dots stay evenly weighted at small sizes.
export component Logo inherits Image {
    in property <length> size: 40px;
    in property <color> tint: Theme.text;
    width: root.size * 1.506;
    height: root.size;
    source: @image-url("../assets/logo.png");
    image-fit: contain;
    colorize: root.tint;
}

export component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

export component TdsSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> neutral: 0;
    in property <brush> fill-brush: Theme.accent;
    in-out property <float> value: 0;
    callback changed(float);

    height: 24px;
    property <length> knob: 13px;
    property <float> span: Math.max(0.000001, root.maximum - root.minimum);
    property <float> ratio: Math.min(1, Math.max(0, (root.value - root.minimum) / root.span));
    property <float> neutral-ratio: Math.min(1, Math.max(0, (root.neutral - root.minimum) / root.span));

    function seek(x: length) {
        if (root.width <= root.knob) {
            return;
        }
        self.value = root.minimum + root.span * Math.min(1, Math.max(0,
            (x - root.knob / 2) / (root.width - root.knob)));
        root.changed(self.value);
    }

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
    }

    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: (parent.width - root.knob) * root.ratio + root.knob / 2;
        height: 4px;
        border-radius: 2px;
        background: root.fill-brush;
    }

    Rectangle {
        x: (parent.width - root.knob) * root.neutral-ratio + root.knob / 2 - 1px;
        y: (parent.height - 12px) / 2;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: Theme.text-faint;
        opacity: Math.abs(root.ratio - root.neutral-ratio) < 0.012 ? 0 : 0.75;
        animate opacity { duration: 130ms; }
    }

    Rectangle {
        x: (parent.width - root.knob) * root.ratio;
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: touch.pressed ? Theme.text : Theme.accent;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.accent.transparentize(0.55);
        animate background { duration: 90ms; }
    }

    touch := TouchArea {
        moved => {
            if (self.pressed) {
                root.seek(self.mouse-x);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.seek(self.mouse-x);
            }
        }
    }
}

export component ValueBox inherits Rectangle {
    in property <string> text;
    in property <bool> changed: false;
    callback committed(string);

    width: 82px;
    height: 34px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    border-width: 1px;
    border-color: field.has-focus
        ? Theme.accent.transparentize(0.5)
        : (root.changed ? Theme.accent.transparentize(0.78) : Theme.border);
    animate border-color { duration: 120ms; }

    field := TextInput {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.changed ? Theme.accent : Theme.text;
        font-size: 12px;
        font-family: "Consolas";
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            root.committed(self.text);
            self.clear-focus();
        }
    }
}

export component ResetDot inherits Rectangle {
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.has-hover ? Theme.raised : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent.transparentize(0.6) : Theme.border;
    animate background, border-color { duration: 110ms; }

    IconReset {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 17px;
        tint: touch.has-hover ? Theme.accent : Theme.text-dim;
    }

    IconResetHead {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 17px;
        tint: touch.has-hover ? Theme.accent : Theme.text-dim;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <length> text-size: 12px;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.raised : Theme.panel-alt;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        text: root.text;
        color: Theme.text;
        font-size: root.text-size;
        font-family: Theme.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    @children

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AccentButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 38px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.accent-deep : Theme.accent;

    Text {
        text: root.text;
        color: #0a0a0b;
        font-size: 13px;
        font-weight: 700;
        font-family: Theme.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component IconButton inherits Rectangle {
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.raised : Theme.panel;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-hover : Theme.border;
    animate background, border-color { duration: 110ms; }

    @children

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked: true;
    callback toggled(bool);

    width: 52px;
    height: 28px;
    border-radius: 14px;
    background: root.checked ? Theme.accent : Theme.track;
    animate background { duration: 140ms; }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.checked ? #0a0a0b : Theme.text-dim;
        animate x { duration: 140ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
