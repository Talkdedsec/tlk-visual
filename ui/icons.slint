//
// Every glyph is drawn as a vector path: Segoe UI has no reliable coverage for
// the symbols this panel needs, and missing glyphs render as tofu boxes.

component Glyph inherits Path {
    in property <length> size: 18px;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-line-cap: round;
}

export component IconClose inherits Glyph {
    in property <color> tint: #8b8b95;
    commands: "M7.2 7.2 L16.8 16.8 M16.8 7.2 L7.2 16.8";
    stroke: root.tint;
    stroke-width: root.size / 11;
}

export component IconMinimize inherits Glyph {
    in property <color> tint: #8b8b95;
    commands: "M7 12 L17 12";
    stroke: root.tint;
    stroke-width: root.size / 11;
}

