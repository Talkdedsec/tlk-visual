import { Theme } from "theme.slint";
import { Card, TdsSlider, ValueBox, ResetDot, GhostButton, AccentButton, IconButton, Toggle, Logo, KeyCap } from "widgets.slint";
import { IconClose, IconMinimize, IconPlay, IconSliders, IconSlidersKnobs, IconSun, IconContrast, IconContrastFill, IconMoon, IconSplit, IconTrash, IconEye, IconImport, IconExport, IconDoc } from "icons.slint";

export struct Preset {
    name: string,
    hint: string,
    thumb: image,
}

export struct DisplayEntry {
    name: string,
    on: bool,
}

/// Slider ranges. Rust sets them from the engine's own clamps at startup, so a
/// slider can never reach a value the engine would pull back.
export global Ranges {
    in property <float> brightness-min: -0.35;
    in property <float> brightness-max: 0.35;
    in property <float> contrast-min: 0.6;
    in property <float> contrast-max: 1.8;
    in property <float> gamma-min: 0.5;
    in property <float> gamma-max: 2.2;
    in property <float> temperature-min: -1.0;
    in property <float> temperature-max: 1.0;
    in property <float> night-vision-min: 0.0;
    in property <float> night-vision-max: 1.0;
}

component Kicker inherits Text {
    color: Theme.text-faint;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.3px;
    font-family: Theme.font;
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 16px;
    font-weight: 700;
    font-family: Theme.font;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border-soft;
}

component ControlRow inherits Rectangle {
    in property <string> label;
    in property <string> caption;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> neutral;
    in property <brush> fill-brush;
    in property <string> display;
    in property <bool> touched;
    in-out property <float> value;
    callback changed(float);
    callback committed(string);
    callback reset();

    height: 40px;
    border-radius: 9px;
    background: hover.has-hover ? Theme.panel-alt : transparent;
    animate background { duration: 120ms; }

    hover := TouchArea {
        mouse-cursor: default;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            width: 128px;
            horizontal-stretch: 0;

            Text {
                text: root.label;
                color: root.touched ? Theme.text : Theme.text-dim;
                font-size: 12px;
                font-weight: 600;
                font-family: Theme.font;
            }

            Text {
                text: root.caption;
                color: Theme.text-faint;
                font-size: 9px;
                font-family: Theme.font;
            }
        }

        TdsSlider {
            y: (parent.height - self.height) / 2;
            minimum: root.minimum;
            maximum: root.maximum;
            neutral: root.neutral;
            fill-brush: root.fill-brush;
            label: root.label;
            value: root.value;
            horizontal-stretch: 1;
            changed(v) => {
                root.changed(v);
            }
        }

        ResetDot {
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;
            label: @tr("Reset {}", root.label);
            clicked => {
                root.reset();
            }
        }

        ValueBox {
            y: (parent.height - self.height) / 2;
            text: root.display;
            label: root.label;
            changed: root.touched;
            horizontal-stretch: 0;
            committed(v) => {
                root.committed(v);
            }
        }
    }
}

component ControlCard inherits Card {
    in property <string> kicker;
    in property <string> title;
    in property <string> glyph;
    in property <color> glyph-color: Theme.accent;
    callback reset-block();

    VerticalLayout {
        padding: 12px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 13px;
            padding-bottom: 2px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                border-radius: 10px;
                background: root.glyph-color.transparentize(0.86);
                horizontal-stretch: 0;

                if root.glyph == "sun": IconSun {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 20px;
                    tint: root.glyph-color;
                }

                if root.glyph == "color": IconContrast {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 20px;
                    tint: root.glyph-color;
                }

                if root.glyph == "color": IconContrastFill {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 20px;
                    tint: root.glyph-color;
                }

                if root.glyph == "moon": IconMoon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 19px;
                    tint: root.glyph-color;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Kicker {
                    text: root.kicker;
                }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    font-family: Theme.font;
                }
            }

            GhostButton {
                y: (parent.height - self.height) / 2;
                text: @tr("Reset block");
                width: 112px;
                horizontal-stretch: 0;
                clicked => {
                    root.reset-block();
                }
            }
        }

        @children
    }
}

/// One saved profile. Deleting takes two clicks: the first turns the bin into a
/// question, the second answers it; moving away takes the question back.
component ProfileRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    callback pick();
    callback remove();
    property <bool> armed: false;

    height: 38px;
    border-radius: 9px;
    background: root.selected ? Theme.raised : (row.has-hover ? Theme.panel : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.accent.transparentize(0.55) : transparent;
    animate background, border-color { duration: 110ms; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => {
        root.pick();
    }

    row := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.armed = false;
            root.pick();
        }
        changed has-hover => {
            if (!self.has-hover && !bin.has-hover) {
                root.armed = false;
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 5px;
        spacing: 6px;

        Text {
            text: root.name;
            color: root.selected ? Theme.text : Theme.text-dim;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: root.armed ? 70px : 28px;
            height: 28px;
            horizontal-stretch: 0;
            border-radius: 8px;
            opacity: row.has-hover || bin.has-hover || root.armed ? 1 : 0;
            background: root.armed ? #3a1520 : (bin.has-hover ? #2a1218 : transparent);
            animate width, opacity, background { duration: 110ms; }
            accessible-role: button;
            accessible-label: root.armed ? @tr("Delete?") : @tr("Delete profile");
            accessible-action-default => {
                bin.press();
            }

            if !root.armed: IconTrash {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 15px;
                tint: bin.has-hover ? #ff6b6b : Theme.text-faint;
            }

            if root.armed: Text {
                text: @tr("Delete?");
                color: #ff6b6b;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            bin := TouchArea {
                mouse-cursor: pointer;
                function press() {
                    if (root.armed) {
                        root.armed = false;
                        root.remove();
                    } else {
                        root.armed = true;
                    }
                }
                clicked => {
                    self.press();
                }
                changed has-hover => {
                    if (!self.has-hover && !row.has-hover) {
                        root.armed = false;
                    }
                }
            }
        }
    }
}

/// The transfer curve as a picture: input along the bottom, output up the side.
/// One line while the channels agree, red, green and blue once they part.
component CurveGraph inherits Rectangle {
    in property <string> red;
    in property <string> green;
    in property <string> blue;
    in property <bool> mono: true;

    border-radius: 9px;
    background: #08080a;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    accessible-role: image;
    accessible-label: @tr("Transfer curve");

    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;

        for q in [0.25, 0.5, 0.75]: Rectangle {
            x: parent.width * q;
            width: 1px;
            height: parent.height;
            background: Theme.border-soft;
        }

        for q in [0.25, 0.5, 0.75]: Rectangle {
            y: parent.height * q;
            width: parent.width;
            height: 1px;
            background: Theme.border-soft;
        }

        // where every level would stay without the effect
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 255;
            viewbox-height: 255;
            commands: "M0 255 L255 0";
            stroke: Theme.text-faint;
            stroke-width: 1px;
            fill: transparent;
            opacity: 0.6;
        }

        if !root.mono: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 255;
            viewbox-height: 255;
            commands: root.blue;
            stroke: #5b8cff;
            stroke-width: 2px;
            fill: transparent;
        }

        if !root.mono: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 255;
            viewbox-height: 255;
            commands: root.green;
            stroke: #5fd97a;
            stroke-width: 2px;
            fill: transparent;
        }

        if !root.mono: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 255;
            viewbox-height: 255;
            commands: root.red;
            stroke: #ff6161;
            stroke-width: 2px;
            fill: transparent;
        }

        if root.mono: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 255;
            viewbox-height: 255;
            commands: root.red;
            stroke: Theme.accent;
            stroke-width: 2px;
            fill: transparent;
        }
    }
}

/// A labelled figure, for what the engine is doing right now.
component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> warn: false;

    height: 54px;
    border-radius: 9px;
    background: Theme.panel-alt;
    border-width: 1px;
    border-color: root.warn ? #ffb14d55 : Theme.border;
    animate border-color { duration: 160ms; }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 10px;
        alignment: center;
        spacing: 3px;

        Kicker {
            text: root.label;
        }

        Text {
            text: root.value;
            color: root.warn ? #ffb14d : Theme.text;
            font-size: 16px;
            font-weight: 700;
            overflow: elide;
        }
    }
}


/// A frameless window has no native resize border, so the grips are drawn here.
/// Edge is a bitmask: 1 left, 2 right, 4 top, 8 bottom.
component ResizeFrame inherits Rectangle {
    callback resize(int, length, length);
    property <length> grip: 7px;

    TouchArea {
        x: 0;
        y: root.grip;
        width: root.grip;
        height: parent.height - root.grip * 2;
        mouse-cursor: ew-resize;
        moved => { if (self.pressed) { root.resize(1, self.mouse-x - self.pressed-x, 0px); } }
    }

    TouchArea {
        x: parent.width - root.grip;
        y: root.grip;
        width: root.grip;
        height: parent.height - root.grip * 2;
        mouse-cursor: ew-resize;
        moved => { if (self.pressed) { root.resize(2, self.mouse-x - self.pressed-x, 0px); } }
    }

    TouchArea {
        x: root.grip;
        y: 0;
        width: parent.width - root.grip * 2;
        height: root.grip;
        mouse-cursor: ns-resize;
        moved => { if (self.pressed) { root.resize(4, 0px, self.mouse-y - self.pressed-y); } }
    }

    TouchArea {
        x: root.grip;
        y: parent.height - root.grip;
        width: parent.width - root.grip * 2;
        height: root.grip;
        mouse-cursor: ns-resize;
        moved => { if (self.pressed) { root.resize(8, 0px, self.mouse-y - self.pressed-y); } }
    }

    TouchArea {
        x: 0;
        y: 0;
        width: root.grip;
        height: root.grip;
        mouse-cursor: nwse-resize;
        moved => { if (self.pressed) { root.resize(5, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
    }

    TouchArea {
        x: parent.width - root.grip;
        y: 0;
        width: root.grip;
        height: root.grip;
        mouse-cursor: nesw-resize;
        moved => { if (self.pressed) { root.resize(6, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
    }

    TouchArea {
        x: 0;
        y: parent.height - root.grip;
        width: root.grip;
        height: root.grip;
        mouse-cursor: nesw-resize;
        moved => { if (self.pressed) { root.resize(9, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
    }

    TouchArea {
        x: parent.width - root.grip;
        y: parent.height - root.grip;
        width: root.grip;
        height: root.grip;
        mouse-cursor: nwse-resize;
        moved => { if (self.pressed) { root.resize(10, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
    }

    Rectangle {
        x: parent.width - 17px;
        y: parent.height - 17px;
        width: 11px;
        height: 11px;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M11 1 L1 11 M11 5.5 L5.5 11 M11 10 L10 11";
            stroke: Theme.text-faint;
            stroke-width: 1.2px;
            stroke-line-cap: round;
            opacity: 0.7;
        }
    }
}

export component MainWindow inherits Window {
    title: "Talkdedsec Visual";
    background: Theme.bg;
    no-frame: true;
    default-font-family: Theme.font;
    // 1920x1080 at 125% scaling leaves 1536x864 logical pixels, and that is the
    // most common laptop setup, so the window has to fit inside it.
    preferred-width: 1300px;
    preferred-height: 828px;
    min-width: 1160px;
    min-height: 680px;

    in-out property <float> brightness: 0;
    in-out property <float> contrast: 1;
    in-out property <float> gamma: 1;
    in-out property <float> temperature: 0;
    in-out property <float> night-vision: 0;

    in property <string> brightness-text: "+0.00";
    in property <string> contrast-text: "1.00";
    in property <string> gamma-text: "1.00";
    in property <string> temperature-text: "+0.00";
    in property <string> night-vision-text: "0.00";

    in property <bool> engine-active: false;
    in property <bool> comparing: false;
    in property <string> status-text: @tr("Ready.");
    in property <string> status-detail: @tr("Display untouched.");
    in-out property <bool> auto-apply: true;

    in property <string> curve-red: "M0 255 L255 0";
    in property <string> curve-green: "M0 255 L255 0";
    in property <string> curve-blue: "M0 255 L255 0";
    in property <bool> curve-mono: true;
    in property <string> strength-text: "—";
    in property <bool> strength-warn: false;
    in property <string> displays-text: "—";

    in property <image> preview-before;
    in property <image> preview-after;
    in-out property <float> split: 0.46;

    in property <[Preset]> presets;
    in property <[string]> profiles;
    in property <int> selected-profile: -1;
    in-out property <int> selected-preset: -1;
    in-out property <string> profile-name: "";

    in property <bool> settings-open: false;
    in property <bool> autostart: false;
    in property <bool> tray-on-close: true;
    in property <[string]> hotkeys;
    in property <int> hotkey-index: 3;
    in property <[DisplayEntry]> displays;
    in property <string> language: "en";
    in property <string> version: "0.1.0";
    /// Set from Rust when the window is short. Bound to `root.height` here, it
    /// would feed the layout that decides the height: a binding loop.
    in property <bool> compact: false;

    callback changed(string, float);
    callback committed(string, string);
    callback reset-block(string);
    callback reset-all();
    callback apply-now();
    callback compare(bool);
    callback toggle-auto(bool);
    callback pick-preset(int);
    callback pick-profile(int);
    callback delete-profile(int);
    callback save-profile();
    callback import-profiles();
    callback export-profiles();
    callback open-source();
    callback open-settings();
    callback close-settings();
    callback set-autostart(bool);
    callback set-tray-close(bool);
    callback set-hotkey(int);
    callback set-display(int, bool);
    callback set-language(string);
    callback move-window(length, length);
    callback resize-window(int, length, length);
    callback minimize();
    callback quit();

    VerticalLayout {
        spacing: 0;

        // ---- title bar -------------------------------------------------------
        Rectangle {
            height: 58px;
            background: Theme.panel-alt;
            vertical-stretch: 0;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            TouchArea {
                moved => {
                    if (self.pressed) {
                        root.move-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 10px;

                Logo {
                    y: (parent.height - self.height) / 2;
                    size: 40px;
                    horizontal-stretch: 0;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 0;

                    Text {
                        text: "TALKDEDSEC";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 800;
                        letter-spacing: 1.4px;
                    }

                    Kicker {
                        text: "VISUAL ENGINE";
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 38px;
                    width: 142px;
                    horizontal-stretch: 0;
                    border-radius: 10px;
                    background: root.engine-active ? Theme.accent.transparentize(0.9) : Theme.panel;
                    border-width: 1px;
                    border-color: root.engine-active ? Theme.accent.transparentize(0.6) : Theme.border;
                    animate background, border-color { duration: 200ms; }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.engine-active ? Theme.accent : Theme.text-faint;

                            states [
                                pulsing when root.engine-active: {
                                    opacity: 0.35;
                                    in {
                                        animate opacity {
                                            duration: 900ms;
                                            iteration-count: -1;
                                            direction: alternate;
                                            easing: ease-in-out;
                                        }
                                    }
                                }
                            ]
                        }

                        Text {
                            text: root.engine-active ? @tr("ACTIVE") : @tr("IDLE");
                            color: root.engine-active ? Theme.accent : Theme.text-dim;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                    }
                }

                gear := IconButton {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 0;
                    label: @tr("Settings");
                    clicked => {
                        root.open-settings();
                    }

                    IconSliders {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 18px;
                        tint: gear.hovered ? Theme.text : Theme.text-dim;
                    }

                    IconSlidersKnobs {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 18px;
                        tint: gear.hovered ? Theme.text : Theme.text-dim;
                    }
                }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 40px;
                    horizontal-stretch: 0;
                    border-radius: Theme.radius-sm;
                    background: apply-touch.pressed ? Theme.accent-deep : Theme.accent;
                    animate background { duration: 90ms; }
                    accessible-role: button;
                    accessible-label: @tr("Apply now");
                    accessible-action-default => {
                        root.apply-now();
                    }

                    IconPlay {
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                        size: 17px;
                        tint: #0a0a0b;
                    }

                    apply-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.apply-now();
                        }
                    }
                }

                Rectangle {
                    width: 6px;
                    horizontal-stretch: 0;
                }

                mini := IconButton {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 0;
                    label: @tr("Minimise");
                    clicked => {
                        root.minimize();
                    }

                    IconMinimize {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 18px;
                        tint: mini.hovered ? Theme.text : Theme.text-dim;
                    }
                }

                shut := IconButton {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 0;
                    label: @tr("Close");
                    clicked => {
                        root.quit();
                    }

                    IconClose {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 17px;
                        tint: shut.hovered ? #ff6b6b : Theme.text-dim;
                    }
                }
            }
        }

        HorizontalLayout {
            padding: 10px;
            spacing: 10px;

            // ---- left rail ----------------------------------------------------
            VerticalLayout {
                width: 246px;
                horizontal-stretch: 0;
                spacing: 10px;

                Card {
                    vertical-stretch: 1;
                    background: Theme.panel-alt;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 7px;

                        Kicker {
                            text: @tr("PRESETS");
                        }

                        SectionTitle {
                            text: @tr("Ready-made looks");
                        }

                        Rectangle {
                            height: 2px;
                        }

                        Rectangle {
                            height: 40px;
                            border-radius: 10px;
                            background: root.selected-preset == -1 ? Theme.raised : (custom-row.has-hover ? Theme.panel : transparent);
                            border-width: 1px;
                            border-color: root.selected-preset == -1 ? Theme.accent.transparentize(0.55) : Theme.border-soft;
                            animate background, border-color { duration: 110ms; }

                            HorizontalLayout {
                                padding-left: 13px;
                                padding-right: 8px;
                                spacing: 8px;

                                Text {
                                    text: @tr("Custom");
                                    color: root.selected-preset == -1 ? Theme.text : Theme.text-dim;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 30px;
                                    height: 30px;
                                    horizontal-stretch: 0;
                                    border-radius: 8px;
                                    background: cog.has-hover ? Theme.panel : transparent;
                                    accessible-role: button;
                                    accessible-label: @tr("Settings");
                                    accessible-action-default => {
                                        root.open-settings();
                                    }

                                    IconSliders {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 15px;
                                        tint: cog.has-hover ? Theme.accent : Theme.text-faint;
                                    }

                                    IconSlidersKnobs {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 15px;
                                        tint: cog.has-hover ? Theme.accent : Theme.text-faint;
                                    }

                                    cog := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open-settings();
                                        }
                                    }
                                }
                            }

                            custom-row := TouchArea {
                                mouse-cursor: default;
                            }
                        }

                        for preset[i] in root.presets: Rectangle {
                            height: 50px;
                            border-radius: 11px;
                            accessible-role: button;
                            accessible-label: preset.name;
                            accessible-description: preset.hint;
                            accessible-action-default => {
                                root.pick-preset(i);
                            }
                            background: root.selected-preset == i ? Theme.raised : (prow.has-hover ? Theme.panel : transparent);
                            border-width: 1px;
                            border-color: root.selected-preset == i ? Theme.accent.transparentize(0.55) : transparent;
                            animate background, border-color { duration: 110ms; }

                            HorizontalLayout {
                                padding: 7px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    padding-left: 5px;

                                    Text {
                                        text: preset.name;
                                        color: root.selected-preset == i ? Theme.text : Theme.text-dim;
                                        font-size: 12px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: preset.hint;
                                        color: Theme.text-faint;
                                        font-size: 9px;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    width: 84px;
                                    horizontal-stretch: 0;
                                    border-radius: 7px;
                                    clip: true;

                                    Image {
                                        source: preset.thumb;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: cover;
                                    }

                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: #ffffff1a;
                                    }
                                }
                            }

                            prow := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pick-preset(i);
                                }
                            }
                        }

                        Rectangle {
                            height: 6px;
                        }

                        Divider { }

                        Kicker {
                            text: @tr("MY PROFILES");
                        }

                        if root.profiles.length == 0: Rectangle {
                            vertical-stretch: 1;

                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;

                                Rectangle {
                                    height: 32px;
                                    IconEye {
                                        x: (parent.width - self.width) / 2;
                                        size: 26px;
                                        tint: Theme.text-faint;
                                    }
                                }

                                Text {
                                    text: @tr("No profiles yet");
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: @tr("Save one from the panel on the right.");
                                    color: Theme.text-faint;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // The presets above are fixed; the profiles take what is left and scroll.
                        if root.profiles.length > 0: Rectangle {
                            vertical-stretch: 1;
                            min-height: 40px;

                            list := Flickable {
                                width: parent.width;
                                height: parent.height;
                                viewport-height: root.profiles.length * 40px;

                                for profile[i] in root.profiles: ProfileRow {
                                    x: 0;
                                    y: i * 40px;
                                    width: list.width - (list.viewport-height > list.height ? 8px : 0px);
                                    name: profile;
                                    selected: root.selected-profile == i;
                                    pick => {
                                        root.pick-profile(i);
                                    }
                                    remove => {
                                        root.delete-profile(i);
                                    }
                                }
                            }

                            if list.viewport-height > list.height: Rectangle {
                                x: parent.width - 3px;
                                width: 3px;
                                height: Math.max(24px, parent.height * (list.height / list.viewport-height));
                                y: (parent.height - self.height) * (-list.viewport-y / Math.max(1px, list.viewport-height - list.height));
                                border-radius: 1.5px;
                                background: Theme.border-hover;
                            }
                        }
                    }
                }

                // A short window needs the room for the presets; the source link stays in settings.
                if !root.compact: Card {
                    height: 104px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 5px;

                        Kicker {
                            text: @tr("OPEN SOURCE");
                            color: Theme.purple;
                        }

                        Text {
                            text: @tr("The source code is open");
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Text {
                            text: @tr("GPL-3.0 · contributions welcome");
                            color: Theme.text-faint;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        Rectangle {
                            height: 34px;
                            vertical-stretch: 0;
                            border-radius: 9px;
                            background: src.has-hover ? #6a4de0 : Theme.purple;
                            animate background { duration: 120ms; }
                            accessible-role: button;
                            accessible-label: @tr("Open on GitHub");
                            accessible-action-default => {
                                root.open-source();
                            }

                            Text {
                                text: @tr("Open on GitHub");
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            src := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-source();
                                }
                            }
                        }
                    }
                }
            }

            // ---- centre column -------------------------------------------------
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                ControlCard {
                    kicker: @tr("BASICS");
                    title: @tr("Light & Tone");
                    glyph: "sun";
                    vertical-stretch: 0;
                    reset-block => {
                        root.reset-block("light");
                    }

                    ControlRow {
                        label: @tr("Brightness");
                        caption: @tr("lifts the black level");
                        minimum: Ranges.brightness-min;
                        maximum: Ranges.brightness-max;
                        neutral: 0;
                        value: root.brightness;
                        display: root.brightness-text;
                        touched: root.brightness != 0;
                        fill-brush: @linear-gradient(90deg, #1c1c20 0%, #ffffff 100%);
                        changed(v) => {
                            root.changed("brightness", v);
                        }
                        committed(v) => {
                            root.committed("brightness", v);
                        }
                        reset => {
                            root.changed("brightness", 0);
                        }
                    }

                    ControlRow {
                        label: @tr("Contrast");
                        caption: @tr("shadow–highlight separation");
                        minimum: Ranges.contrast-min;
                        maximum: Ranges.contrast-max;
                        neutral: 1.0;
                        value: root.contrast;
                        display: root.contrast-text;
                        touched: root.contrast != 1;
                        fill-brush: @linear-gradient(90deg, #4a4a52 0%, #e8e8ee 100%);
                        changed(v) => {
                            root.changed("contrast", v);
                        }
                        committed(v) => {
                            root.committed("contrast", v);
                        }
                        reset => {
                            root.changed("contrast", 1);
                        }
                    }
                }

                ControlCard {
                    kicker: @tr("COLOUR");
                    title: @tr("Gamma & Temperature");
                    glyph: "color";
                    glyph-color: Theme.magenta;
                    vertical-stretch: 0;
                    reset-block => {
                        root.reset-block("color");
                    }

                    ControlRow {
                        label: @tr("Gamma");
                        caption: @tr("weight of the midtones");
                        minimum: Ranges.gamma-min;
                        maximum: Ranges.gamma-max;
                        neutral: 1.0;
                        value: root.gamma;
                        display: root.gamma-text;
                        touched: root.gamma != 1;
                        fill-brush: @linear-gradient(90deg, #241f30 0%, #d946ef 100%);
                        changed(v) => {
                            root.changed("gamma", v);
                        }
                        committed(v) => {
                            root.committed("gamma", v);
                        }
                        reset => {
                            root.changed("gamma", 1);
                        }
                    }

                    ControlRow {
                        label: @tr("Colour Temperature");
                        caption: @tr("cool to warm");
                        minimum: Ranges.temperature-min;
                        maximum: Ranges.temperature-max;
                        neutral: 0;
                        value: root.temperature;
                        display: root.temperature-text;
                        touched: root.temperature != 0;
                        fill-brush: @linear-gradient(90deg, #4da6ff 0%, #e8e8ee 50%, #ffb14d 100%);
                        changed(v) => {
                            root.changed("temperature", v);
                        }
                        committed(v) => {
                            root.committed("temperature", v);
                        }
                        reset => {
                            root.changed("temperature", 0);
                        }
                    }
                }

                ControlCard {
                    kicker: @tr("VISION");
                    title: @tr("Night Vision");
                    glyph: "moon";
                    glyph-color: #56d66c;
                    vertical-stretch: 0;
                    reset-block => {
                        root.reset-block("vision");
                    }

                    ControlRow {
                        label: @tr("Night Vision");
                        caption: @tr("separates detail in the dark");
                        minimum: Ranges.night-vision-min;
                        maximum: Ranges.night-vision-max;
                        neutral: 0;
                        value: root.night-vision;
                        display: root.night-vision-text;
                        touched: root.night-vision != 0;
                        fill-brush: @linear-gradient(90deg, #10231a 0%, #56d66c 100%);
                        changed(v) => {
                            root.changed("night_vision", v);
                        }
                        committed(v) => {
                            root.committed("night_vision", v);
                        }
                        reset => {
                            root.changed("night_vision", 0);
                        }
                    }
                }

                // A short window would squeeze the preview to a sliver; hold-to-compare
                // on the real screen still works without it.
                if root.compact: Rectangle {
                    vertical-stretch: 1;
                }

                // the reference leaves this space empty; the live preview earns it
                if !root.compact: Card {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            padding-left: 2px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Kicker {
                                    text: @tr("LIVE PREVIEW");
                                }

                                Text {
                                    text: @tr("Your settings before they reach the screen");
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 700;
                                }
                            }

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 170px;
                                height: 34px;
                                horizontal-stretch: 0;
                                border-radius: 9px;
                                background: root.comparing ? Theme.accent : (hold.has-hover ? Theme.raised : Theme.panel-alt);
                                border-width: 1px;
                                border-color: root.comparing ? Theme.accent : Theme.border;
                                animate background { duration: 90ms; }
                                accessible-role: button;
                                accessible-label: @tr("hold to compare");

                                Text {
                                    text: root.comparing ? @tr("showing the original") : @tr("hold to compare");
                                    color: root.comparing ? #0a0a0b : Theme.text-dim;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                hold := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            root.compare(true);
                                        }
                                        if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                            root.compare(false);
                                        }
                                    }
                                }
                            }
                        }

                        stage := Rectangle {
                            vertical-stretch: 1;
                            border-radius: 10px;
                            clip: true;
                            background: #050506;

                            Image {
                                source: root.preview-after;
                                width: 100%;
                                height: 100%;
                                image-fit: fill;
                            }

                            Rectangle {
                                x: 0;
                                width: parent.width * root.split;
                                height: 100%;
                                clip: true;

                                Image {
                                    x: 0;
                                    width: stage.width;
                                    height: stage.height;
                                    source: root.preview-before;
                                    image-fit: fill;
                                }
                            }

                            Rectangle {
                                x: parent.width * root.split - 1px;
                                width: 2px;
                                height: 100%;
                                background: Theme.accent;
                            }

                            Rectangle {
                                x: parent.width * root.split - 15px;
                                y: parent.height / 2 - 15px;
                                width: 30px;
                                height: 30px;
                                border-radius: 15px;
                                background: Theme.accent;
                                drop-shadow-blur: 14px;
                                drop-shadow-color: #000000;

                                IconSplit {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: 16px;
                                }
                            }

                            Rectangle {
                                x: 11px;
                                y: 11px;
                                width: 64px;
                                height: 23px;
                                border-radius: 6px;
                                background: #000000cc;

                                Text {
                                    text: @tr("BEFORE");
                                    color: Theme.text-dim;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                x: parent.width - self.width - 11px;
                                y: 11px;
                                width: 64px;
                                height: 23px;
                                border-radius: 6px;
                                background: #000000cc;

                                Text {
                                    text: @tr("AFTER");
                                    color: Theme.accent;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            drag := TouchArea {
                                mouse-cursor: ew-resize;
                                moved => {
                                    if (self.pressed) {
                                        root.split = Math.min(1, Math.max(0, self.mouse-x / stage.width));
                                    }
                                }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down) {
                                        root.split = Math.min(1, Math.max(0, self.mouse-x / stage.width));
                                    }
                                }
                            }
                        }
                    }
                }

                Card {
                    height: 58px;
                    vertical-stretch: 0;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Kicker {
                                text: @tr("STATUS");
                            }

                            Text {
                                text: root.status-text;
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }

                        // The global shortcut flips exactly this toggle, so its key sits next to it.
                        if root.hotkey-index >= 0: KeyCap {
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 0;
                            text: root.hotkeys[root.hotkey-index];
                        }

                        Text {
                            text: @tr("AUTO-APPLY");
                            color: Theme.text-dim;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0.8px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }

                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.auto-apply;
                            label: @tr("Auto-apply");
                            horizontal-stretch: 0;
                            toggled(on) => {
                                root.toggle-auto(on);
                            }
                        }

                        GhostButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Reset");
                            width: 112px;
                            horizontal-stretch: 0;
                            clicked => {
                                root.reset-all();
                            }
                        }
                    }
                }
            }

            // ---- right rail ----------------------------------------------------
            VerticalLayout {
                width: 278px;
                horizontal-stretch: 0;
                spacing: 10px;

                Card {
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 9px;

                            IconDoc {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                tint: Theme.accent;
                                horizontal-stretch: 0;
                            }

                            Kicker {
                                text: @tr("SAVED PROFILE");
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        SectionTitle {
                            text: @tr("Create a profile");
                        }

                        Text {
                            text: @tr("Saves the five sliders under a name.");
                            color: Theme.text-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-sm;
                            background: Theme.panel-alt;
                            border-width: 1px;
                            border-color: input.has-focus ? Theme.accent.transparentize(0.55) : Theme.border;
                            animate border-color { duration: 130ms; }

                            if root.profile-name == "": Text {
                                x: 13px;
                                text: @tr("Profile name");
                                color: Theme.text-faint;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            input := TextInput {
                                x: 13px;
                                width: parent.width - 26px;
                                height: 100%;
                                accessible-label: @tr("Profile name");
                                text: root.profile-name;
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                single-line: true;
                                edited => {
                                    root.profile-name = self.text;
                                }
                                accepted => {
                                    root.save-profile();
                                }
                            }
                        }

                        AccentButton {
                            text: @tr("Save profile");
                            clicked => {
                                root.save-profile();
                            }
                        }
                    }
                }

                Card {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 11px;

                        Kicker {
                            text: @tr("ENGINE");
                        }

                        SectionTitle {
                            text: @tr("Transfer curve");
                        }

                        Text {
                            text: @tr("What each input level becomes on screen. The diagonal is the display left alone.");
                            color: Theme.text-faint;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        CurveGraph {
                            vertical-stretch: 1;
                            min-height: 80px;
                            red: root.curve-red;
                            green: root.curve-green;
                            blue: root.curve-blue;
                            mono: root.curve-mono;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;

                            Stat {
                                label: @tr("STRENGTH");
                                value: root.strength-text;
                                warn: root.strength-warn;
                            }

                            Stat {
                                label: @tr("DISPLAYS");
                                value: root.displays-text;
                            }
                        }

                        Text {
                            text: root.status-detail;
                            color: Theme.text-faint;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    vertical-stretch: 0;

                    imp := GhostButton {
                        height: 40px;
                        text: "";
                        label: @tr("Import");
                        clicked => {
                            root.import-profiles();
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            IconImport {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                tint: Theme.text-dim;
                            }

                            Text {
                                text: @tr("Import");
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    exp := GhostButton {
                        height: 40px;
                        text: "";
                        label: @tr("Export");
                        clicked => {
                            root.export-profiles();
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            IconExport {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                tint: Theme.text-dim;
                            }

                            Text {
                                text: @tr("Export");
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.settings-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000c4;

        TouchArea {
            clicked => {
                root.close-settings();
            }
        }

        // Escape closes the dialog, as it does everywhere else on Windows.
        FocusScope {
            width: 0px;
            height: 0px;
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-settings();
                    return accept;
                }
                reject
            }
        }

        Card {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            // As tall as what it holds, and never taller than the window.
            height: Math.min(body.preferred-height, parent.height - 24px);
            accessible-role: groupbox;
            accessible-label: @tr("SETTINGS");

            TouchArea { }

            body := VerticalLayout {
                padding: 22px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Kicker {
                            text: @tr("SETTINGS");
                        }

                        Text {
                            text: "Talkdedsec Visual";
                            color: Theme.text;
                            font-size: 19px;
                            font-weight: 700;
                        }
                    }

                    close := IconButton {
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 0;
                        label: @tr("Close");
                        clicked => {
                            root.close-settings();
                        }

                        IconClose {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 17px;
                            tint: close.hovered ? #ff6b6b : Theme.text-dim;
                        }
                    }
                }

                Divider { }

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Start with Windows");
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Text {
                            text: @tr("Opens minimised to the tray.");
                            color: Theme.text-faint;
                            font-size: 10px;
                        }
                    }

                    Toggle {
                        y: (parent.height - self.height) / 2;
                        checked: root.autostart;
                        label: @tr("Start with Windows");
                        horizontal-stretch: 0;
                        toggled(on) => {
                            root.set-autostart(on);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Minimise to the tray on close");
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Text {
                            text: @tr("When off, the close button quits the program.");
                            color: Theme.text-faint;
                            font-size: 10px;
                        }
                    }

                    Toggle {
                        y: (parent.height - self.height) / 2;
                        checked: root.tray-on-close;
                        label: @tr("Minimise to the tray on close");
                        horizontal-stretch: 0;
                        toggled(on) => {
                            root.set-tray-close(on);
                        }
                    }
                }

                Divider { }

                if root.displays.length > 0: VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("Displays");
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    Text {
                        text: @tr("Only the selected displays are changed. 1 is the main display.");
                        color: Theme.text-faint;
                        font-size: 10px;
                    }

                    HorizontalLayout {
                        spacing: 7px;
                        alignment: start;

                        // As wide as a language chip, narrower when more displays have to fit.
                        for panel[i] in root.displays: Rectangle {
                            height: 38px;
                            horizontal-stretch: 1;
                            min-width: 64px;
                            preferred-width: 234px;
                            max-width: 234px;
                            border-radius: 9px;
                            background: panel.on ? Theme.accent : (panel-chip.has-hover ? Theme.raised : Theme.panel-alt);
                            border-width: 1px;
                            border-color: panel.on ? Theme.accent : Theme.border;
                            animate background { duration: 110ms; }
                            accessible-role: checkbox;
                            accessible-label: panel.name;
                            accessible-checkable: true;
                            accessible-checked: panel.on;
                            accessible-action-default => {
                                root.set-display(i, !panel.on);
                            }

                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: panel.name;
                                color: panel.on ? #0a0a0b : Theme.text-dim;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            panel-chip := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.set-display(i, !panel.on);
                                }
                            }
                        }
                    }
                }

                if root.displays.length > 0: Divider { }

                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("Global shortcut");
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    Text {
                        text: @tr("Turns the filter on and off while you are in a game.");
                        color: Theme.text-faint;
                        font-size: 10px;
                    }

                    HorizontalLayout {
                        spacing: 7px;

                        for key[i] in root.hotkeys: Rectangle {
                            height: 38px;
                            border-radius: 9px;
                            background: root.hotkey-index == i ? Theme.accent : (chip.has-hover ? Theme.raised : Theme.panel-alt);
                            border-width: 1px;
                            border-color: root.hotkey-index == i ? Theme.accent : Theme.border;
                            animate background { duration: 110ms; }
                            accessible-role: button;
                            accessible-label: key;
                            accessible-action-default => {
                                root.set-hotkey(i);
                            }

                            Text {
                                text: key;
                                color: root.hotkey-index == i ? #0a0a0b : Theme.text-dim;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            chip := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.set-hotkey(i);
                                }
                            }
                        }
                    }
                }

                Divider { }

                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("Language");
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }

                    Text {
                        text: @tr("The window, tray menu and messages. Follows Windows until you pick one.");
                        color: Theme.text-faint;
                        font-size: 10px;
                    }

                    HorizontalLayout {
                        spacing: 7px;

                        // Each language is named in itself, so it stays findable in either language.
                        for entry in [{ code: "en", name: "English" }, { code: "tr", name: "Türkçe" }]: Rectangle {
                            height: 38px;
                            border-radius: 9px;
                            background: root.language == entry.code ? Theme.accent : (lang-chip.has-hover ? Theme.raised : Theme.panel-alt);
                            border-width: 1px;
                            border-color: root.language == entry.code ? Theme.accent : Theme.border;
                            animate background { duration: 110ms; }
                            accessible-role: button;
                            accessible-label: entry.name;
                            accessible-action-default => {
                                root.set-language(entry.code);
                            }

                            Text {
                                text: entry.name;
                                color: root.language == entry.code ? #0a0a0b : Theme.text-dim;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            lang-chip := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.set-language(entry.code);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Divider { }

                HorizontalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: @tr("Version {} · GPL-3.0", root.version);
                            color: Theme.text-dim;
                            font-size: 11px;
                        }

                        Text {
                            text: "© 2026 Talkdedsec";
                            color: Theme.text-faint;
                            font-size: 10px;
                        }
                    }

                    GhostButton {
                        y: (parent.height - self.height) / 2;
                        text: @tr("Source code");
                        width: 128px;
                        horizontal-stretch: 0;
                        clicked => {
                            root.open-source();
                        }
                    }
                }
            }
        }
    }

    ResizeFrame {
        width: 100%;
        height: 100%;
        resize(edge, dx, dy) => {
            root.resize-window(edge, dx, dy);
        }
    }
}
